{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-search-hit.schema.json",
  "title": "KnowledgeSearchHit",
  "type": "object",
  "additionalProperties": false,
  "required": ["segmentId", "startSeconds", "endSeconds", "text", "score", "matchedTerms", "matchedConceptIds", "topicIds"],
  "properties": {
    "segmentId": { "type": "string", "minLength": 1 },
    "startSeconds": { "type": "number", "minimum": 0 },
    "endSeconds": { "type": "number", "minimum": 0 },
    "text": { "type": "string" },
    "score": { "type": "number", "minimum": 0 },
    "matchedTerms": { "type": "array", "items": { "type": "string" } },
    "matchedConceptIds": { "type": "array", "items": { "type": "string" } },
    "topicIds": { "type": "array", "items": { "type": "string" } }
  }
}
