{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".projectr-test-build"
  },
  "include": ["core/projectr/**/*.ts", "adapters/transcripts/**/*.ts", "adapters/metadata/**/*.ts", "adapters/knowledge/**/*.ts", "adapters/persistence/**/*.ts", "tests/core/**/*.ts", "tests/adapters/**/*.ts"]
}
